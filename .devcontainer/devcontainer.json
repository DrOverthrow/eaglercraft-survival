{
  "name": "Eaglercraft Survival Server",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "25",
      "installMaven": false,
      "installGradle": false
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    }
  },
  "forwardPorts": [
    25565
  ],
  "portsAttributes": {
    "25565": {
      "label": "Eaglercraft WebSocket server",
      "onAutoForward": "notify",
      "protocol": "http"
    }
  },
  "postCreateCommand": "python3 --version && java -version"
}
